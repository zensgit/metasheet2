      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_attempt",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (attempt_no >= 0 AND attempt_no <= 5)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_channel",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (channel = ANY (ARRAY['none'::text, 'legacy_directory_webhook'::text, 'group_extension'::text]))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_channel_shape",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN channel = 'none'::text THEN route_ref = 'none'::text AND status = 'skipped'::text\n    WHEN channel = 'legacy_directory_webhook'::text THEN route_ref = 'legacy.directory_sync'::text AND attempt_no <= 1 AND status <> 'queued'::text\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_failed",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'failed'::text THEN attempt_no > 0 AND\n    CASE\n        WHEN retry_safety = 'not_started'::text THEN started_at IS NULL AND lease_id IS NULL AND result_code = 'transport_not_started'::text\n        WHEN retry_safety = 'definitive_failure'::text THEN started_at IS NOT NULL AND lease_id IS NOT NULL AND result_code = 'provider_rejected'::text\n        ELSE false\n    END\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_finish",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = ANY (ARRAY['queued'::text, 'sending'::text]) THEN finished_at IS NULL AND result_code IS NULL\n    ELSE finished_at IS NOT NULL AND finished_at >= created_at AND result_code IS NOT NULL\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_lease",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK ((lease_id IS NULL) = (lease_until IS NULL) AND (lease_id IS NULL OR started_at IS NOT NULL AND lease_until > started_at))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_next",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (next_attempt_at IS NULL OR status = 'failed'::text AND (retry_safety = ANY (ARRAY['not_started'::text, 'definitive_failure'::text])) AND attempt_no < 5 AND next_attempt_at >= finished_at)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_order",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (started_at IS NULL OR started_at >= created_at AND (finished_at IS NULL OR finished_at >= started_at))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_queued",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'queued'::text THEN attempt_no > 0 AND started_at IS NULL AND lease_id IS NULL AND retry_safety = 'not_started'::text\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_result",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (result_code = ANY (ARRAY['channel_unconfigured'::text, 'plugin_unavailable'::text, 'source_not_eligible'::text, 'transport_not_started'::text, 'provider_rejected'::text, 'send_outcome_unknown'::text, 'legacy_sent_observed'::text, 'legacy_outcome_unknown'::text, 'attempt_limit'::text, 'delivered'::text]))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_retry",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (retry_safety = ANY (ARRAY['not_started'::text, 'definitive_failure'::text, 'unknown'::text, 'not_applicable'::text]))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_route",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (char_length(route_ref) >= 1 AND char_length(route_ref) <= 128 AND route_ref ~ '^[a-z_]+([.][a-z_]+)*$'::text)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_sending",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'sending'::text THEN attempt_no > 0 AND started_at IS NOT NULL AND lease_id IS NOT NULL AND lease_until > started_at AND retry_safety = 'unknown'::text\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_skipped",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'skipped'::text THEN started_at IS NULL AND lease_id IS NULL AND retry_safety = 'not_applicable'::text AND (result_code = ANY (ARRAY['channel_unconfigured'::text, 'plugin_unavailable'::text, 'source_not_eligible'::text, 'legacy_sent_observed'::text, 'legacy_outcome_unknown'::text, 'attempt_limit'::text]))\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_status",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (status = ANY (ARRAY['queued'::text, 'sending'::text, 'succeeded'::text, 'failed'::text, 'unknown'::text, 'skipped'::text]))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_success",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'succeeded'::text THEN attempt_no > 0 AND started_at IS NOT NULL AND lease_id IS NOT NULL AND retry_safety = 'not_applicable'::text AND result_code = 'delivered'::text\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_times",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (isfinite(created_at) AND isfinite(due_at) AND isfinite(expires_at) AND expires_at > created_at AND due_at >= created_at AND (started_at IS NULL OR isfinite(started_at)) AND (finished_at IS NULL OR isfinite(finished_at)) AND (lease_until IS NULL OR isfinite(lease_until)) AND (next_attempt_at IS NULL OR isfinite(next_attempt_at)))"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_unique",
        "contype": "u",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "UNIQUE (event_id, channel, route_ref, attempt_no)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_unknown",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN status = 'unknown'::text THEN attempt_no > 0 AND started_at IS NOT NULL AND lease_id IS NOT NULL AND retry_safety = 'unknown'::text AND result_code = 'send_outcome_unknown'::text\n    ELSE true\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_event_deliveries",
        "conname": "sed_zero",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN attempt_no = 0 THEN status = 'skipped'::text AND started_at IS NULL AND lease_id IS NULL AND lease_until IS NULL AND retry_safety = 'not_applicable'::text\n    ELSE status <> 'skipped'::text OR started_at IS NULL\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_events",
        "conname": "se_actor",
        "contype": "c",
        "convalidated": true,
        "condeferrable": false,
        "condeferred": false,
        "target_schema": null,
        "target": null,
        "definition": "CHECK (\nCASE\n    WHEN actor_kind = 'user'::text THEN actor_user_id IS NOT NULL AND char_length(actor_user_id) >= 1 AND char_length(actor_user_id) <= 128\n    ELSE actor_user_id IS NULL\nEND)"
      },
      {
        "source_schema": "public",
        "source": "security_events",
