{
  "$comment": [
    "THE single truth table for the URL-only webhook target check. Read from disk by BOTH sides:",
    "  packages/core-backend/tests/unit/webhook-target-shape-parity.test.ts -> src/multitable/webhook-ssrf-guard.ts checkWebhookTargetUrlShape",
    "                                                                          (+ webhook-refusal-class.ts classifyWebhookRefusal for refusalClass)",
    "  apps/web/tests/webhook-target-hint.spec.ts                           -> apps/web/src/multitable/utils/webhookTargetHint.ts classifyWebhookTarget",
    "expected: ok | empty | malformed | not_https | internal_name | internal_ip. Server reason per class:",
    "  ok = shape.ok; empty = 'URL is required'; malformed = 'URL is malformed'; not_https = 'scheme not allowed: ...';",
    "  internal_name = 'target host is internal'; internal_ip = 'target IP is internal'.",
    "refusalClass (refused rows only) = classifyWebhookRefusal(url, reason).refusalClass, the class the save-time errors carry.",
    "Example values only: example.com, RFC 5737 / RFC 3849 documentation addresses, private / loopback literals."
  ],
  "cases": [
    { "name": "plain public https name", "url": "https://example.com/hook", "expected": "ok" },
    { "name": "upper-case host", "url": "https://EXAMPLE.COM/hook", "expected": "ok" },
    { "name": "upper-case scheme", "url": "HTTPS://example.com/hook", "expected": "ok" },
    { "name": "port, path and query", "url": "https://example.com:8443/a/b?x=1#f", "expected": "ok" },
    { "name": "trailing-dot public name", "url": "https://example.com./hook", "expected": "ok" },
    { "name": "surrounding spaces (URL parser trims)", "url": "  https://example.com/hook  ", "expected": "ok" },
    { "name": "name that merely contains localhost", "url": "https://localhost.example.com/", "expected": "ok" },
    { "name": "name that merely contains .local", "url": "https://svc.local.example.com/", "expected": "ok" },
    { "name": "name ending in internalx", "url": "https://svc.internalx/", "expected": "ok" },
    { "name": "RFC 5737 TEST-NET-1", "url": "https://192.0.2.10/hook", "expected": "ok" },
    { "name": "RFC 5737 TEST-NET-2", "url": "https://198.51.100.7/", "expected": "ok" },
    { "name": "RFC 5737 TEST-NET-3", "url": "https://203.0.113.9/", "expected": "ok" },
    { "name": "RFC 3849 IPv6 documentation address", "url": "https://[2001:db8::1]/hook", "expected": "ok" },
    { "name": "IPv4-mapped (hex) documentation address", "url": "https://[::ffff:c000:20a]/", "expected": "ok" },
    { "name": "IPv4-mapped (dotted) documentation address", "url": "https://[::ffff:192.0.2.10]/", "expected": "ok" },

    { "name": "empty string", "url": "", "expected": "empty", "refusalClass": "invalid-url" },
    { "name": "blank string", "url": "   ", "expected": "empty", "refusalClass": "invalid-url" },
    { "name": "null", "url": null, "expected": "empty", "refusalClass": "invalid-url" },

    { "name": "free text", "url": "not a url", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "no scheme", "url": "example.com/hook", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "scheme only", "url": "https://", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "out-of-range dotted quad", "url": "https://999.1.1.1/", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "unclosed IPv6 bracket", "url": "https://[::1/", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "IPv6 with a zone id", "url": "https://[fe80::1%25eth0]/", "expected": "malformed", "refusalClass": "invalid-url" },
    { "name": "space inside host", "url": "https://exa mple.com/", "expected": "malformed", "refusalClass": "invalid-url" },

    { "name": "http public name", "url": "http://example.com/hook", "expected": "not_https", "refusalClass": "scheme-not-allowed" },
    { "name": "http loopback (scheme is checked first)", "url": "http://127.0.0.1/hook", "expected": "not_https", "refusalClass": "loopback" },
    { "name": "http private (scheme is checked first)", "url": "http://192.168.1.10/", "expected": "not_https", "refusalClass": "private" },
    { "name": "ftp", "url": "ftp://example.com/", "expected": "not_https", "refusalClass": "scheme-not-allowed" },
    { "name": "wss", "url": "wss://example.com/", "expected": "not_https", "refusalClass": "scheme-not-allowed" },
    { "name": "file", "url": "file:///tmp/x", "expected": "not_https", "refusalClass": "scheme-not-allowed" },
    { "name": "mailto", "url": "mailto:ops@example.com", "expected": "not_https", "refusalClass": "scheme-not-allowed" },

    { "name": "localhost", "url": "https://localhost/hook", "expected": "internal_name", "refusalClass": "loopback" },
    { "name": "upper-case localhost", "url": "https://LOCALHOST:8443/", "expected": "internal_name", "refusalClass": "loopback" },
    { "name": "trailing-dot localhost", "url": "https://localhost./", "expected": "internal_name", "refusalClass": "loopback" },
    { "name": "*.localhost", "url": "https://api.localhost/", "expected": "internal_name", "refusalClass": "loopback" },
    { "name": "*.local", "url": "https://printer.local/", "expected": "internal_name", "refusalClass": "internal-name" },
    { "name": "*.internal", "url": "https://svc.internal/", "expected": "internal_name", "refusalClass": "internal-name" },
    { "name": "trailing-dot *.internal", "url": "https://svc.internal./", "expected": "internal_name", "refusalClass": "internal-name" },

    { "name": "loopback 127.0.0.1", "url": "https://127.0.0.1/hook", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "loopback 127/8 with port", "url": "https://127.1.2.3:8443/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "loopback short form 127.1", "url": "https://127.1/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "loopback decimal integer", "url": "https://2130706433/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "loopback hex octet", "url": "https://0x7f.1/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "loopback octal", "url": "https://0177.0.0.1/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "10/8", "url": "https://10.0.0.5/", "expected": "internal_ip", "refusalClass": "private" },
    { "name": "172.16/12 low edge", "url": "https://172.16.0.1/", "expected": "internal_ip", "refusalClass": "private" },
    { "name": "172.16/12 high edge", "url": "https://172.31.255.255/", "expected": "internal_ip", "refusalClass": "private" },
    { "name": "192.168/16", "url": "https://192.168.1.10/", "expected": "internal_ip", "refusalClass": "private" },
    { "name": "link-local metadata literal", "url": "https://169.254.169.254/latest", "expected": "internal_ip", "refusalClass": "link-local" },
    { "name": "this-host 0.0.0.0", "url": "https://0.0.0.0/", "expected": "internal_ip", "refusalClass": "unspecified" },
    { "name": "IPv6 loopback", "url": "https://[::1]/hook", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "IPv6 loopback, long form", "url": "https://[0:0:0:0:0:0:0:1]/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "IPv6 unspecified", "url": "https://[::]/", "expected": "internal_ip", "refusalClass": "unspecified" },
    { "name": "IPv6 ULA fc00::/7 (fc)", "url": "https://[fc00::1]/", "expected": "internal_ip", "refusalClass": "unique-local" },
    { "name": "IPv6 ULA fc00::/7 (fd)", "url": "https://[fd12:3456::1]/", "expected": "internal_ip", "refusalClass": "unique-local" },
    { "name": "IPv6 link-local fe80", "url": "https://[fe80::1]/", "expected": "internal_ip", "refusalClass": "link-local" },
    { "name": "IPv6 link-local fe80::/10 high edge", "url": "https://[febf::1]/", "expected": "internal_ip", "refusalClass": "link-local" },
    { "name": "IPv4-mapped loopback (dotted)", "url": "https://[::ffff:127.0.0.1]/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "IPv4-mapped loopback (hex)", "url": "https://[::ffff:7f00:1]/", "expected": "internal_ip", "refusalClass": "loopback" },
    { "name": "IPv4-mapped private", "url": "https://[::ffff:10.0.0.1]/", "expected": "internal_ip", "refusalClass": "private" }
  ]
}
