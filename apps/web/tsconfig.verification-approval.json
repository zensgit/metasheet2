{
  // P7-R1 (FAIL-1 rot-class closure): the harnesses under verification/ live outside src/, so
  // tsconfig.app.json's `include` never reaches them and `vue-tsc -b` (the CI-required
  // `type-check` gate) is blind to a broken ApprovalNodeConfigEditorApi implementation there — the
  // exact mechanism FAIL-1 exploited (8 missing members + a 2-vs-3-arg signature drift produced
  // ZERO compile-time signal). This standalone, non-composite project type-checks the approval
  // approval browser harnesses and their real production import closure without folding
  // verification/ into the composite `tsconfig.app.json` build graph. Each included harness/spec is
  // exercised by the dedicated Approval Browser Verify lane; unrelated verification/*.ts files
  // remain out of scope, while the normal web typecheck continues to own the complete src/ tree.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.verification-approval.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.d.ts",
    "verification/approval-*-harness.ts",
    "verification/approval-*.spec.ts"
  ]
}
