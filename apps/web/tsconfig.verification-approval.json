{
  // P7-R1 (FAIL-1 rot-class closure): the harnesses under verification/ live outside src/, so
  // tsconfig.app.json's `include` never reaches them and `vue-tsc -b` (the CI-required
  // `type-check` gate) is blind to a broken ApprovalNodeConfigEditorApi implementation there — the
  // exact mechanism FAIL-1 exploited (8 missing members + a 2-vs-3-arg signature drift produced
  // ZERO compile-time signal). This standalone, non-composite project type-checks the approval
  // approval browser harnesses against the SAME src/ tree without folding verification/ into the
  // composite `tsconfig.app.json` build graph. Each included harness is exercised by the dedicated
  // Approval Browser Verify lane; unrelated verification/*.ts files remain out of scope.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.verification-approval.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "verification/approval-inspector-keyboard-harness.ts",
    "verification/approval-form-builder-mounted-harness.ts",
    "verification/approval-member-action-dialog-harness.ts"
  ]
}
