{
  // Tasks acceptance-walk lane type gate, sibling of tsconfig.verification-approval.json and for the
  // same reason: verification/ lives outside tsconfig.app.json's `include` (`src/**`), so `vue-tsc -b`
  // never sees these files, and a harness that drifts from the production signatures it calls (the
  // record drawer's props, the dispatch binding, the route records) would give no compile-time signal.
  //
  // Non-composite and `noEmit`: it type-checks the tasks harness, its fixtures and its spec with
  // their production import closure, without folding verification/ into the app build graph. Run by
  // tasks-web-guard.yml before the browser walk.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.verification-tasks.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.d.ts",
    "verification/tasks-*-harness.ts",
    "verification/tasks-*-fixtures.ts",
    "verification/tasks-*.spec.ts"
  ]
}
