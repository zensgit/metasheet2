# Attendance on-prem single-node ready draft
# Replace the 3 `change-me` values below before deployment, AND fill the two empty
# ENCRYPTION_* values (they are required in production — see the comment next to them).

NODE_ENV=production
HOST=127.0.0.1
PORT=8900

PRODUCT_MODE=attendance
DEPLOYMENT_MODEL=onprem

JWT_SECRET=change-me

# Stored-credential encryption material (data source passwords, DingTalk appSecret, encrypted
# system_configs). REQUIRED in production: the backend fail-closes and refuses to encrypt or
# decrypt when either is unset or left at its built-in default value
# (packages/core-backend/src/security/encrypted-secrets.ts). Generate each independently with
# `openssl rand -hex 32`. Changing them after secrets exist orphans the stored ciphertext —
# rotate deliberately, do not edit in place.
ENCRYPTION_KEY=
ENCRYPTION_SALT=
BCRYPT_SALT_ROUNDS=12

POSTGRES_USER=metasheet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metasheet
DATABASE_URL=postgres://metasheet:change-me@127.0.0.1:5432/metasheet
DB_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ATTENDANCE_IMPORT_REQUIRE_TOKEN=1
ATTENDANCE_IMPORT_UPLOAD_DIR=/opt/metasheet/storage/attendance-import
ATTENDANCE_IMPORT_CSV_MAX_ROWS=100000
ATTENDANCE_IMPORT_HEAVY_QUERY_TIMEOUT_MS=180000
