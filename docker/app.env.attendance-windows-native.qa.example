# Windows-native internal QA only. Replace every change-me value.

NODE_ENV=production
HOST=127.0.0.1
PORT=8900

PRODUCT_MODE=attendance
DEPLOYMENT_MODEL=onprem

JWT_SECRET=change-me
BCRYPT_SALT_ROUNDS=12

POSTGRES_USER=metasheet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metasheet_qa
DATABASE_URL=postgres://metasheet:change-me@127.0.0.1:5432/metasheet_qa
DB_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ATTENDANCE_IMPORT_REQUIRE_TOKEN=1
ATTENDANCE_IMPORT_UPLOAD_DIR=storage/attendance-import
ATTENDANCE_IMPORT_CSV_MAX_ROWS=100000
ATTENDANCE_IMPORT_HEAVY_QUERY_TIMEOUT_MS=180000

WINDOWS_NATIVE_GATEWAY_HOST=127.0.0.1
WINDOWS_NATIVE_GATEWAY_PORT=8080
WINDOWS_NATIVE_BACKEND_ORIGIN=http://127.0.0.1:8900
