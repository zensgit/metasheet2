#!/usr/bin/env bash
# Logging wrapper for `tar`. With a non-GNU tar (macOS bsdtar) a verbose listing is rewritten to
# the GNU column layout (size in column 3), which is what the deploy host's GNU tar prints.
printf 'tar\t-\t-\t-\t%s\n' "$*" >> "${H_CALLS}"
if [[ "${H_TAR_IS_GNU:-1}" != "1" && "${1:-}" == "-tvf" ]]; then
  "${H_REAL_TAR}" -tvf "$2" | awk '{ name = $9; for (i = 10; i <= NF; i++) name = name " " $i; printf "%s %s/%s %s 2026-01-01 00:00 %s\n", $1, $3, $4, $5, name }'
  exit "${PIPESTATUS[0]}"
fi
exec "${H_REAL_TAR}" "$@"
