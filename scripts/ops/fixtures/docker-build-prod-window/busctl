#!/usr/bin/env bash
# Test double for the logind KillUserProcesses property read. It always answers, so the window
# never falls back to the runner's own /etc/systemd/logind.conf.
printf 'busctl\t-\t-\t-\t%s\n' "$*" >> "${H_CALLS}"
[[ "${1:-}" == "get-property" && "$*" == *KillUserProcesses* ]] || exit 99
echo "b ${H_KILL_USER_PROCESSES:-false}"
