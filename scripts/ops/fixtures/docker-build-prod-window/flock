#!/usr/bin/env bash
# Stand-in for util-linux flock, installed only where flock is absent (macOS). Uses flock(2)
# through perl: `flock [-n] <fd>` locks the inherited open file description (the lock outlives
# this process while the caller keeps the fd); `flock [-n] <path> <command...>` holds it while
# the command runs.
nb=0
if [[ "${1:-}" == "-n" ]]; then nb=1; shift; fi
target="${1:?}"
shift
if [[ "$target" =~ ^[0-9]+$ ]]; then
  exec perl -e 'use Fcntl ":flock"; open(my $fh, ">&=", $ARGV[0]) or exit 1; flock($fh, LOCK_EX | ($ARGV[1] ? LOCK_NB : 0)) or exit 1; exit 0' "$target" "$nb"
fi
exec perl -e 'use Fcntl ":flock"; my ($p, $nb, @c) = @ARGV; open(my $fh, ">>", $p) or exit 1; flock($fh, LOCK_EX | ($nb ? LOCK_NB : 0)) or exit 1; my $rc = system(@c); exit($rc == -1 ? 127 : ($rc & 127 ? 128 + ($rc & 127) : $rc >> 8))' "$target" "$nb" "$@"
