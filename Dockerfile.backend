FROM node:20-slim AS builder

WORKDIR /app
ARG PNPM_VERSION=10.16.1
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY packages ./packages
COPY plugins ./plugins
COPY apps ./apps
COPY scripts ./scripts

ENV CI=true
RUN pnpm install --frozen-lockfile --shamefully-hoist
RUN pnpm --filter @metasheet/core-backend build

FROM node:20-slim AS runner

WORKDIR /app
ARG PNPM_VERSION=10.16.1
ARG VCS_REF=unknown
ARG BUILD_IMAGE_TAG=unknown
ARG BUILD_IMAGE_SOURCE=unknown
ARG BUILD_CREATED=unknown
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8900
# E-learning M1: ffprobe/ffmpeg are a deployment dependency (server-side duration/codec probe).
# Node's bundled roots are only the bootstrap trust, not the Debian system roots.
# Keep Debian signature checks; remove bootstrap trust after installing system CA.
RUN node -e 'require("fs").writeFileSync("/tmp/elearning-apt-bootstrap-ca.pem", require("tls").rootCertificates.join("\n") + "\n")' \
  && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=3 -o Acquire::https::Timeout=30 -o Acquire::https::CaInfo=/tmp/elearning-apt-bootstrap-ca.pem update \
  && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 -o Acquire::https::CaInfo=/tmp/elearning-apt-bootstrap-ca.pem install -y --no-install-recommends ca-certificates \
  && test -s /etc/ssl/certs/ca-certificates.crt \
  && rm /tmp/elearning-apt-bootstrap-ca.pem \
  && apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update \
  && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends ffmpeg \
  && command -v ffprobe \
  && rm -rf /var/lib/apt/lists/*
ENV METASHEET_BUILD_COMMIT=${VCS_REF}
ENV METASHEET_BUILD_IMAGE_TAG=${BUILD_IMAGE_TAG}
ENV METASHEET_BUILD_SOURCE=${BUILD_IMAGE_SOURCE}
ENV METASHEET_BUILD_CREATED=${BUILD_CREATED}
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.source="${BUILD_IMAGE_SOURCE}"
LABEL org.opencontainers.image.created="${BUILD_CREATED}"

# Copy entire workspace to preserve monorepo structure
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/plugins ./plugins
COPY --from=builder /app/scripts ./scripts

EXPOSE 8900
CMD ["node", "packages/core-backend/dist/src/index.js"]
